# Production Compose configuration. Copy this file to .env before deployment.
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
CORS_ORIGINS=https://brandfaces.uz,https://www.brandfaces.uz
PUBLIC_PORT=8080
API_PUBLIC_PORT=4000
VITE_API_URL=https://api.brandfaces.uz/api
RUN_MIGRATIONS=true
RUN_SEED=false
SEED_ADMIN_EMAIL=admin@brandfaces.uz
SEED_ADMIN_PASSWORD=replace-with-a-strong-initial-password
BOOTSTRAP_COMPANY_NAME=Brandfaces
LOG_LEVEL=info
APP_PUBLIC_URL=https://brandfaces.uz
EMAIL_FROM=Davomat <no-reply@brandfaces.uz>

# Optional integrations. Leave unset until a provider/device adapter is configured.
# SMTP_URL=smtps://user:password@mail.example.com:465
# TELEGRAM_BOT_TOKEN=123456:replace-me
# DEVICE_API_KEY=replace-with-a-long-random-device-key
