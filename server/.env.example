NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://atlas:atlas_dev_password@localhost:5432/atlas
# Alternatively omit DATABASE_URL and provide DB_HOST, DB_PORT, DB_NAME,
# DB_USER, and DB_PASSWORD. This avoids URL-encoding special characters.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173
RUN_MIGRATIONS=true
RUN_SEED=true
SEED_ADMIN_EMAIL=admin@atlas.local
SEED_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_COMPANY_NAME=Atlas Company
LOG_LEVEL=info
